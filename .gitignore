**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Project instructions and editor/tooling config (not part of the codebase)
claude_code_project_prompt.md
CLAUDE.md
.claude/
# Personal account/setup notes — may contain credentials; keep out of the repo
docs/*.pdf
docs/PREP_CHECKLIST.md

# Secrets and signing material — never commit
*.jks
*.keystore
key.properties
*.p8
*.p12
*.pfx
*.cer
*.mobileprovision
*.pem
.env
.env.*
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
**/service-account*.json

# Firebase deploy cache
.firebase/

# Android build artifacts
android/build/

# Built APKs (versioned, not tracked — binaries bloat the repo)
APKs/*.apk

# Raw font downloads (we use the google_fonts package at runtime)
font/
reports/

# Local debug screenshots — scratch, not part of the project.
errors/
