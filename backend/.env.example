# Copy to .env and fill in real values (never commit .env).
PORT=4000

# Shared MongoDB Atlas connection string (same cluster as the website/admin).
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fitbox?retryWrites=true&w=majority

# Must be IDENTICAL to the website's JWT_SECRET so this backend can verify
# the tokens the website issues at login.
JWT_SECRET=your_shared_jwt_secret_here
