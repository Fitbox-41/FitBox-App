# Copy to .env and fill in real values (never commit .env).
PORT=4000

# Shared MongoDB Atlas connection string (same cluster as the website/admin).
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fitbox?retryWrites=true&w=majority

# Must be IDENTICAL to the website's JWT_SECRET so this backend can verify
# the tokens the website issues at login.
JWT_SECRET=your_shared_jwt_secret_here

# Server-to-server secret for wallet MUTATIONS (credit/redeem). Only trusted
# backends call those endpoints (website checkout for redeem; admin/territory
# for credit) with header `X-Service-Key: <this value>`. End-user clients only
# READ their wallet, so they never need this. Generate a long random string,
# e.g. `openssl rand -hex 32`, and set the SAME value on the website backend.
WALLET_SERVICE_KEY=generate_a_long_random_secret
